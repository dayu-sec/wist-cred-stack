# 运行期配置与凭据表（现场生成；含 sha256 摘要与站点私钥路径）
/configs/
/configs*/

# 开发态运行物（dev/svc.sh 生成：本地凭据表 / pid / 日志 / dev 配置）
/dev/configs/
/dev/.run/
# dev 态 PKI 与接入包（同 /identity：含私钥，绝不入库）
/dev/identity/

# 站点身份（服务器证书 + 私钥）：现场生成、含私钥，绝不入库
/identity/
/identity*/

# 变量解析结果（gops sys update / package 生成）
sys/resolved_vars.yml

# 现场值由 ops-prj 项目维护（values/<系统名>/sys_value.yml），本仓不跟踪 values/ 内容
values/
.env
# 交付锁（`gops sys package` 生成）
/deliver.lock

# 密钥目录（入口 basic auth 口令：`cred_web_password`）
/.wist/
/.galaxy/

# macOS
.DS_Store
.report
.run*
# 迁移（gops >= 1.4）：模块按目标模型分组
sys/*/mods

# 示例验证方（dev/peer-example）的构建产物；它的 Cargo.lock 要入库
/dev/peer-example/target
