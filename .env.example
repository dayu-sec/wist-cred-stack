# 手工 `docker compose` 用的默认值（产品默认，与 sys/merged_vars.yml 一致）。
# `gops sys localize` 会生成同名 `.env`（现场值覆盖这里）；CI 的 `docker compose config`
# 校验也用这份，所以**它是入库文件**。改产品默认请改 sys/setting/vars.yml 再 `gops sys update`。
WIST_SPC=ghcr.io/dayu-sec
CRED_IMAGE_TAG=v0.6.2-alpha
CRED_WEB_IMAGE_TAG=v0.4.2-alpha

# 演示用验证方（两个一起开才生效）
CRED_DEMO_PEER=
CRED_DEMO_PEER_ROLES=read,investigation:run
COMPOSE_PROFILES=

# 专用 bridge：cred 与 web 固定 IP（cred 的入站是 plain HTTP + peer IP 白名单）
CRED_NET_SUBNET=172.28.90.0/24
CRED_IP=172.28.90.10
WEB_IP=172.28.90.11

# 宿主入口：只开 web（443）。默认只绑回环，内网开放时改成内网网卡 IP。
WEB_BIND_IP=127.0.0.1
WEB_HOST_PORT=2444
WEB_DOMAIN=cred.example.com

# 挂载源
CRED_CONFIG_DIR=./configs/cred
WEB_NGINX_CONF=./configs/web/nginx.conf

# 签发上限 / 接入
CRED_MAX_TTL_SECONDS=2592000
CRED_BREAK_GLASS_TTL_SECONDS=7776000
CRED_OVERLAP_SECONDS=300
CRED_PKI_PEERS=wist-ingest=ingest.internal=https://ingest.internal:19443/api/v1/internal/credentials
# 各认证系统的材料目录（name=目录，逗号分隔）；空 = 按脚本默认（栈里会被护栏拦下）。
CRED_PEER_DIRS=
CRED_ONBOARDING_TTL_SECONDS=900
CRED_PEER_CERT_TTL_SECONDS=7776000
CRED_HEARTBEAT_SECONDS=30
# 单次推送 / 探活的超时（跨区链路慢时调大）
CRED_PUSH_TIMEOUT_SECONDS=10

# 时区：数据由 scripts/init-timezone.sh 从宿主复制到 TZ_RUNTIME_DIR，容器只读挂载
TZ=Asia/Shanghai
TZ_RUNTIME_DIR=./configs/runtime/tz
